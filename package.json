{
  "name": "dsh-selection-quote",
  "version": "0.1.0",
  "description": "Cursor + GitHub PR Review style selection quote & comment plugin for DeepSeek Harness (鼠标划词添加到对话 Add to Chat ⌘L + 针对选中文字写注释/批注 Add Comment ⇧⌘L + 输入框上方引用与批注卡片栏)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xt765/dsh-selection-quote.git"
  },
  "author": "xt765 <xt765@foxmail.com>",
  "homepage": "https://github.com/xt765/dsh-selection-quote#readme",
  "bugs": {
    "url": "https://github.com/xt765/dsh-selection-quote/issues"
  },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "lib",
    "locale",
    "assets",
    "cordis.patch.yml",
    "screenshots.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test test/*.test.js"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cordis",
    "selection-quote",
    "add-to-chat",
    "inline-comment",
    "pr-review"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "entry": "./lib/client.js",
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ]
    }
  },
  "license": "MIT"
}
